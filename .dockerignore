# Secrets — must NEVER enter the build context: anything COPY'd into an image
# is recoverable from its layers, even if a later layer "deletes" it.
.env
.env.*

# Local corpus clones (ingestion runs outside the container; corpus lives in Pinecone)
data/

# Local virtualenv — the image builds its own from uv.lock
.venv/

# Version control / editor / tool caches
.git/
.github/
.gitignore
.vscode/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Not needed to serve. Note the leading **/ on tests: under the workspace
# layout the suites live at packages/*/tests/, not a single top-level tests/.
**/tests/
claude/
deploy/
*.md
graph.png

# ...but each package's config.yml IS needed at runtime (it carries the index
# name, models and retrieval settings), and it sits inside the package dir, so
# nothing above may exclude it. Kept explicit as a reminder.
!packages/*/src/*/config.yml
